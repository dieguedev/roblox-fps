{
  "name": "TycoonDeFPS",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Modules": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "WeaponConfig": {
          "$path": "src/shared/WeaponConfig.lua"
        }
      },
      "Remotes": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "FireWeaponEvent": {
          "$className": "RemoteEvent"
        },
        "EquipWeaponEvent": {
          "$className": "RemoteEvent"
        },
        "WeaponEffectsEvent": {
          "$className": "RemoteEvent"
        },
        "HitmarkerEvent": {
          "$className": "RemoteEvent"
        },
        "DamageNumberEvent": {
          "$className": "RemoteEvent"
        },
        "ReloadWeaponEvent": {
          "$className": "RemoteEvent"
        },
        "SlideEvent": {
          "$className": "RemoteEvent"
        }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "WeaponService": {
        "$path": "src/server/WeaponService.server.lua"
      },
      "WeaponAttachment": {
        "$path": "src/server/WeaponAttachment.lua"
      },
      "MovementService": {
        "$path": "src/server/MovementService.server.lua"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "WeaponController": {
          "$path": "src/client/WeaponController.client.lua"
        },
        "MovementController": {
          "$path": "src/client/MovementController.client.lua"
        },
        "HideCursorAndShowCrosshair": {
          "$path": "src/client/HideCursorAndShowCrosshair.client.lua"
        },
        "AmmoUI": {
          "$path": "src/client/AmmoUI.client.lua"
        }
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "WeaponTestDummy": {
        "$className": "Model",
        "$ignoreUnknownInstances": true,
        "RespawnScript": {
          "$path": "src/server/dummy/RespawnScript.server.lua"
        },
        "PatrolScript": {
          "$path": "src/server/dummy/PatrolScript.server.lua"
        },
        "HealthBarScript": {
          "$path": "src/server/dummy/HealthBarScript.server.lua"
        }
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true,
      "Basic Health GUI": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "HealthBarClient": {
          "$path": "src/client/HealthBarClient.client.lua"
        }
      }
    }
  }
}
