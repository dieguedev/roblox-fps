{
  "name": "TycoonDeFPS",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "WeaponConfig": {
        "$path": "src/shared/WeaponConfig.lua"
      },
      "FireWeaponEvent": {
        "$className": "RemoteEvent"
      },
      "EquipWeaponEvent": {
        "$className": "RemoteEvent"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "WeaponService": {
        "$path": "src/server/WeaponService.server.lua"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "WeaponController": {
          "$path": "src/client/WeaponController.client.lua"
        },
        "HideCursorAndShowCrosshair": {
          "$path": "src/client/HideCursorAndShowCrosshair.client.lua"
        }
      }
    }
  }
}
